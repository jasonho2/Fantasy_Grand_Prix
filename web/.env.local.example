# Copy this file to .env.local for local development.
#
# LOCAL DEV: point at the SQLite file the Python pipeline already produces
# (one level up, in the ESPNFF repo root -- "sqlite" in config.json, default
# fantasy_grand_prix.db). No Turso account needed yet.
DATABASE_URL=file:../fantasy_grand_prix.db

# PRODUCTION (Vercel): once you've created a Turso database, set these
# instead (as Vercel project environment variables, not in this file):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# Optional: enables the ESPN tab on the "Add a League" form, gated behind
# this passphrase. Leave unset (locally or in Vercel) to disable ESPN
# self-service entirely -- Sleeper self-service doesn't use this.
# ADD_LEAGUE_PASSPHRASE=choose-something-only-people-you-trust-know
