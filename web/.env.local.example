# Copy this file to .env.local for local development.
#
# LOCAL DEV: point at the SQLite file the Python pipeline already produces
# (one level up, in the ESPNFF repo root). No Turso account needed yet.
DATABASE_URL=file:../espn_ff_1083280.db

# PRODUCTION (Vercel): once you've created a Turso database, set these
# instead (as Vercel project environment variables, not in this file):
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
